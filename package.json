{
	"name": "n8n-nodes-miromiro",
	"version": "0.1.2",
	"description": "n8n node for MiroMiro: turn any live website into Elementor templates, Shopify sections, Tailwind/React/Vue code, brand colors, design tokens and assets.",
	"license": "MIT",
	"homepage": "https://miromiro.app/api",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"miromiro",
		"website",
		"elementor",
		"shopify",
		"liquid",
		"tailwind",
		"design-tokens",
		"brand",
		"website-migration"
	],
	"author": {
		"name": "Soraia Barroso",
		"email": "sorilc@hotmail.com",
		"url": "https://miromiro.app"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SoraiaBarroso/n8n-nodes-miromiro.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MiroMiroApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/MiroMiro/MiroMiro.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.52.5",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
